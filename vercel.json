{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "",
  "functions": {
    "api/*.ts": {
      "includeFiles": "scripts/notion-openapi.json"
    }
  },
  "routes": [
    { "src": "/mcp", "dest": "/api/mcp" },
    { "src": "/sse", "dest": "/api/sse" },
    { "src": "/health", "dest": "/api/health" },
    { "src": "/test", "dest": "/api/test" }
  ]
}
